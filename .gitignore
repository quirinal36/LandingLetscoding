# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 기획용 생성 원본 이미지·영상 (용량이 커서 로컬에만 둔다)
prototypes/**/*.png
prototypes/**/*.jpg
prototypes/**/*.jpeg
prototypes/**/*.webp
prototypes/**/*.mp4
prototypes/**/*.mov
prototypes/**/*.webm

